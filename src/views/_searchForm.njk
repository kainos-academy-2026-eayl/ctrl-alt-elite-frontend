<form class="search-form" action="/search" method="get" role="search">
  <label class="visually-hidden" for="search-input">{{ t('search.label') }}</label>
  <input class="search-input" id="search-input" type="search" name="q" value="{{ searchTerm }}" maxlength="100"
    placeholder="{{ t('search.placeholder') }}" />
  <button class="search-button" type="submit">{{ t('search.button') }}</button>
</form>
