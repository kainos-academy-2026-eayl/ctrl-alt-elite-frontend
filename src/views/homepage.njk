<!doctype html>
<html lang="en">

<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="description" content="Welcome to Ctrl-Alt-Elite. Log in or browse products." />
  <link rel="stylesheet" href="/assets/styles.css" />
  <title>Ctrl-Alt-Elite | Home</title>
</head>

<body class="home-page">
  <header class="site-header">
    <div class="page-width header-content">
      <a class="brand" href="/" aria-label="Ctrl-Alt-Elite home">
        <span class="brand-mark" aria-hidden="true">C</span>
        <span>Ctrl-Alt-Elite</span>
      </a>
      <nav class="primary-nav" aria-label="Main navigation">
        <details class="account-menu" data-account-menu>
          <summary aria-label="{{ accountName }} options">
            <svg class="account-avatar" viewBox="0 0 64 64" width="32" height="32" aria-hidden="true" focusable="false">
              <circle cx="32" cy="32" r="32" fill="#dcfce7" />
              <circle cx="32" cy="24" r="11" fill="#14532d" />
              <path d="M12 57a20 20 0 0 1 40 0" fill="#14532d" />
            </svg>
            <span class="account-label{% if isAuthenticated %} account-name{% endif %}">{{ accountName }}</span>
          </summary>
          <ul class="account-menu-list">
            {% if isAuthenticated %}
            <li><a class="account-menu-link" href="/profile">My Profile</a></li>
            <li>
              <form action="/logout" method="post">
                <button class="account-menu-link account-menu-button" type="submit">Logout</button>
              </form>
            </li>
            {% else %}
            <li><a class="account-menu-link" href="/login">Login</a></li>
            <li><a class="account-menu-link" href="/register">Register</a></li>
            {% endif %}
          </ul>
        </details>
      </nav>
    </div>
  </header>

  <main>
    <section class="page-width welcome" aria-labelledby="welcome-heading">
      <p class="eyebrow">Welcome to Ctrl-Alt-Elite</p>
      <h1 id="welcome-heading">Find your next favourite.</h1>
      <p class="welcome-copy">
        Explore our collection and find something made for your everyday.
      </p>
    </section>
  </main>

  <footer class="site-footer">
    <div class="page-width">
      <p>&copy; <span data-current-year></span> Ctrl-Alt-Elite</p>
    </div>
  </footer>
  <script src="/controllers/script.js" defer></script>
</body>

</html>