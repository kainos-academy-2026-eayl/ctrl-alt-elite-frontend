<!doctype html>
<html lang="en">

<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="description" content="Welcome to Ctrl-Alt-Elite. Log in or browse products." />
  <link rel="stylesheet" href="/assets/styles.css" />
  <link rel="stylesheet" href="/assets/basket.css" />
  <title>Ctrl-Alt-Elite | Home</title>
</head>

<body>
  <header class="site-header">
    <div class="page-width header-content">
      <a class="brand" href="/" aria-label="Ctrl-Alt-Elite home">
        <span class="brand-mark" aria-hidden="true">C</span>
        <span>Ctrl-Alt-Elite</span>
      </a>
      <nav class="primary-nav" aria-label="Main navigation">
        <details class="account-menu" data-account-menu>
          <summary>Account</summary>
          <ul class="account-menu-list">
            <li><a class="account-menu-link" href="/register">Register</a></li>
          </ul>
        </details>
        <a class="nav-link basket-icon-link" href="/basket">
          <svg class="basket-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path d="M7 18a2 2 0 1 0 0 4 2 2 0 0 0 0-4Zm10 0a2 2 0 1 0 0 4 2 2 0 0 0 0-4ZM1 2h3.3l.9 2H22l-3.6 8.4a2 2 0 0 1-1.8 1.2H8.1l-1 1.8V16h12v2H5.3a1.3 1.3 0 0 1-1.1-2l1.4-2.6L2.7 4H1V2Z" />
          </svg>
          <span class="basket-visually-hidden" data-basket-link-label>Basket, 0 items</span>
          <span class="basket-badge" data-basket-count aria-hidden="true">0</span>
        </a>
      </nav>
    </div>
  </header>

  <main>
    <section class="page-width welcome" aria-labelledby="welcome-heading">
      <p class="eyebrow">Welcome to Ctrl-Alt-Elite</p>
      <h1 id="welcome-heading">Find your next favourite.</h1>
      <p class="welcome-copy">
        Explore our collection and find something made for your everyday.
      </p>
    </section>

    {% if products and products.length %}
    <section class="page-width products" aria-labelledby="products-heading">
      <h2 id="products-heading">Featured products</h2>
      <ul class="product-grid">
        {% for product in products %}
        <li class="product-card">
          <h3>{{ product.name }}</h3>
          <p class="product-price">£{{ product.price }}</p>
          <button type="button" class="basket-button" data-add-to-basket data-product-id="{{ product.id }}"
            data-product-name="{{ product.name }}" data-product-price="{{ product.price }}">Add to Basket</button>
        </li>
        {% endfor %}
      </ul>
    </section>
    {% endif %}
  </main>

  <footer class="site-footer">
    <div class="page-width">
      <p>&copy; <span data-current-year></span> Ctrl-Alt-Elite</p>
    </div>
  </footer>
  <script src="/controllers/script.js" defer></script>
  <script src="/controllers/basket.js" defer></script>
</body>

</html>