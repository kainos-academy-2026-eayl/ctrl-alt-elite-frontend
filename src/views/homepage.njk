<!doctype html>
<html lang="{{ prefs().locale }}">

<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="description" content="{{ t('home.description') }}" />
  <link rel="stylesheet" href="/assets/styles.css" />
  <link rel="stylesheet" href="/assets/a11y.css" />
  <link rel="stylesheet" href="/assets/basket.css" />
  <link rel="stylesheet" href="/assets/search.css" />
  <link rel="stylesheet" href="/assets/conveyor.css" />
  <title>{{ t('home.title') }}</title>
</head>

<body class="home-page">
  {% include "_pageTop.njk" %}
  <header class="site-header">
    <div class="page-width header-content">
      <a class="brand" href="/" aria-label="{{ t('site.home') }}">
        <span class="brand-mark" aria-hidden="true">C</span>
        <span>{{ t('site.name') }}</span>
      </a>
      <nav class="primary-nav" aria-label="{{ t('site.mainNavigation') }}">
        {% include "_searchForm.njk" %}
        <details class="account-menu" data-account-menu>
          <summary aria-label="{{ t('account.options', { name: accountName }) }}">
            {% if isAuthenticated %}
            <img class="account-avatar" data-account-image width="32" height="32" alt="" hidden />
            {% endif %}
            <svg class="account-avatar" data-account-fallback viewBox="0 0 64 64" width="32" height="32" aria-hidden="true" focusable="false">
              <circle cx="32" cy="32" r="32" fill="#dcfce7" />
              <circle cx="32" cy="24" r="11" fill="#14532d" />
              <path d="M12 57a20 20 0 0 1 40 0" fill="#14532d" />
            </svg>
            <span class="account-label{% if isAuthenticated %} account-name{% endif %}">{{ accountName }}</span>
          </summary>
          <ul class="account-menu-list">
            {% if isAuthenticated %}
            <li data-account-profile-error hidden><p class="account-profile-error" role="status"><a href="/profile">{{ t('account.profileError') }}</a></p></li>
            <li><a class="account-menu-link" href="/profile">{{ t('account.profile') }}</a></li>
            {% if isStaff %}
            <li><a class="account-menu-link" href="/dashboard">{{ t('account.dashboard') }}</a></li>
            {% endif %}
            <li>
              <form action="/logout" method="post">
                <button class="account-menu-link account-menu-button" type="submit">{{ t('account.logout') }}</button>
              </form>
            </li>
            {% else %}
            <li><a class="account-menu-link" href="/login">{{ t('account.login') }}</a></li>
            <li><a class="account-menu-link" href="/register">{{ t('account.register') }}</a></li>
            {% endif %}
            <li><a class="account-menu-link" href="/account/support">{{ t('account.support') }}</a></li>
          </ul>
        </details>
        {% include "_basketLink.njk" %}
      </nav>
    </div>
  </header>

  <main id="main-content" tabindex="-1">
    <section class="page-width welcome" aria-labelledby="welcome-heading">
      <p class="eyebrow">{{ t('home.eyebrow') }}</p>
      <h1 id="welcome-heading">{{ t('home.heading') }}</h1>
      <p class="welcome-copy">
        {{ t('home.intro') }}
        <a class="cta-button" href="/products">{{ t('home.browse') }}</a>
      </p>
    </section>

    {% if conveyorCards.length %}
    <section class="conveyor" aria-labelledby="conveyor-heading">
      <h2 id="conveyor-heading" class="conveyor-heading">{{ t('home.conveyor') }}</h2>
      <div class="conveyor-track">
        {# The second group is a copy so the loop is seamless; it is hidden from screen readers and the keyboard. #}
        {% for isCopy in [false, true] %}
        <ul class="conveyor-group"{% if isCopy %} aria-hidden="true"{% endif %}>
          {% for card in conveyorCards %}
          <li>
            <a class="conveyor-card" href="{{ card.url }}"{% if isCopy %} tabindex="-1"{% endif %}>
              <img class="conveyor-image" src="{{ card.imageUrl }}" alt="" width="200" height="150" />
              <span class="conveyor-name">{{ card.name }}</span>
              <span class="conveyor-price">{{ card.price }}</span>
            </a>
          </li>
          {% endfor %}
        </ul>
        {% endfor %}
      </div>
    </section>
    {% endif %}

    {% if products and products.length %}
    <section class="page-width products" aria-labelledby="products-heading">
      <h2 id="products-heading">{{ t('home.featured') }}</h2>
      <ul class="product-grid">
        {% for product in products %}
        <li class="product-card">
          <img class="product-image featured-image" src="{{ product.imageUrl }}" alt="" width="160" height="120" />
          <h3>{{ product.name }}</h3>
          <p class="product-price">{{ product.price }}</p>
          <div class="product-actions">
            <a class="details-button" href="{{ product.detailsUrl }}" aria-label="{{ t('product.viewDetailsOf', { name: product.name }) }}">{{ t('product.viewDetails') }}</a>
            <form action="{{ addToBasketUrl }}" method="post">
              <input type="hidden" name="productId" value="{{ product.id }}" />
              <button type="submit" class="basket-button">{{ t('product.addToBasket') }}</button>
            </form>
          </div>
        </li>
        {% endfor %}
      </ul>
    </section>
    {% endif %}
  </main>

  <footer class="site-footer">
    <div class="page-width">
      <p>&copy; <span data-current-year></span> {{ t('site.name') }}</p>
    </div>
  </footer>
  {% include "_browserMessages.njk" %}
  <script src="/controllers/script.js" defer></script>
</body>

</html>