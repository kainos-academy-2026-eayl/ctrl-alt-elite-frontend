<!doctype html>
<html lang="en">

<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="description" content="Log in to your Ctrl-Alt-Elite account." />
  <link rel="stylesheet" href="/assets/styles.css" />
  <link rel="stylesheet" href="/assets/Login.css" />
  <title>Log in | Ctrl-Alt-Elite</title>
</head>

<body class="login-page">
  <header class="site-header">
    <div class="page-width header-content">
      <a class="brand" href="/" aria-label="Ctrl-Alt-Elite home">
        <span class="brand-mark" aria-hidden="true">C</span>
        <span>Ctrl-Alt-Elite</span>
      </a>
    </div>
  </header>

  <main>
    <section class="login-container" aria-labelledby="login-heading">
      <p class="eyebrow">Welcome back</p>
      <h1 id="login-heading">Log in</h1>
      <h2>Please enter your details</h2>
      <form class="login-form" action="/login" method="post">
        <p id="loginMessage" class="login-message" role="alert" aria-live="assertive"></p>
        <div class="login-form-group">
          <label for="email">Email address</label>
          <input
            id="email"
            name="email"
            type="email"
            autocomplete="email"
            required
          />
        </div>
        <div class="login-form-group">
          <label for="password">Password</label>
          <input
            id="password"
            name="password"
            type="password"
            autocomplete="current-password"
            required
          />
        </div>
        <button class="login-btn" type="submit">Log in</button>
      </form>
    </section>
  </main>

  <footer class="site-footer">
    <div class="page-width">
      <p>&copy; <span data-current-year></span> Ctrl-Alt-Elite</p>
    </div>
  </footer>
  <script src="/controllers/Login.js" defer></script>
</body>

</html>
