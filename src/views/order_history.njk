{% extends "layout.njk" %}

{% block title %}{{ t('orders.heading') }} | {{ t('site.name') }}{% endblock %}
{% block description %}{{ t('orders.description') }}{% endblock %}

{% block content %}
<section class="page-width basket" aria-labelledby="orders-heading">
    <h1 id="orders-heading">{{ t('orders.heading') }}</h1>
    <p>{{ t('orders.description') }}</p>
    {% if orderError %}
    <p class="basket-alert" role="alert">{{ orderError }}</p>
    {% else %}
    {% for order in orders %}
    <article class="basket-alert">
        <h2>{{ t('orders.number', { id: order.id }) }}</h2>
        <p>{{ order.order_status }}</p>
        <ul>
            {% for product in order.products %}
            <li>{{ t('orders.product', { id: product.product_id, amount: product.amount }) }}</li>
            {% endfor %}
        </ul>
        <p>{{ t('orders.total', { total: order.total }) }}</p>
    </article>
    {% else %}
    <p>{{ t('orders.empty') }}</p>
    {% endfor %}
    {% endif %}
</section>
{% endblock %}
