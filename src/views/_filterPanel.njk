{#
  Filter and sort panel, shared by search.njk and product.njk. The button is a
  <details> summary and the form is a GET, so it works without JavaScript.
  Built by src/util/productFilters.ts (buildFilterPanel).
#}
<div class="filters">
  <details class="filters-panel">
    <summary class="filters-toggle">
      <svg class="filters-icon" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false">
        <path d="M4 6h10M18 6h2M4 12h4M12 12h8M4 18h12M20 18h0" stroke="currentColor" stroke-width="2" stroke-linecap="round" fill="none" />
        <circle cx="16" cy="6" r="2" stroke="currentColor" stroke-width="2" fill="none" />
        <circle cx="10" cy="12" r="2" stroke="currentColor" stroke-width="2" fill="none" />
        <circle cx="18" cy="18" r="2" stroke="currentColor" stroke-width="2" fill="none" />
      </svg>
      <span>{{ t('filters.toggle') }}</span>
      {% if filterPanel.activeCount %}
      <span class="filters-badge">{{ filterPanel.activeCount }}<span class="filters-visually-hidden"> {{ tCount('filters.active', filterPanel.activeCount) }}</span></span>
      {% endif %}
      <span class="filters-visually-hidden">, {{ t('filters.sortedBy', { sort: filterPanel.sortLabel }) }}</span>
    </summary>

    <form class="filters-form" action="{{ filterPanel.action }}" method="get">
      {% if filterPanel.searchTerm !== null %}
      <input type="hidden" name="q" value="{{ filterPanel.searchTerm }}" />
      {% endif %}

      <div class="filters-sort">
        <label class="filters-heading" for="filters-sort">{{ t('filters.sortBy') }}</label>
        <select class="filters-select" id="filters-sort" name="sort">
          {% for option in filterPanel.sortOptions %}
          <option value="{{ option.value }}"{% if option.isSelected %} selected{% endif %}>{{ option.label }}</option>
          {% endfor %}
        </select>
      </div>

      <div class="filters-groups">
        <details class="filters-group">
          <summary class="filters-group-toggle">
            <span class="filters-group-title">{{ t('filters.availability') }}</span>
            <span class="filters-group-value">{{ filterPanel.stockSummary }}</span>
          </summary>
          <fieldset class="filters-group-body">
            <legend class="filters-visually-hidden">{{ t('filters.availability') }}</legend>
            {% for option in filterPanel.stockOptions %}
            <div class="filters-choice">
              <input id="filters-stock-{{ option.value }}" type="checkbox" name="stock" value="{{ option.value }}"{% if option.isChecked %} checked{% endif %} />
              <label for="filters-stock-{{ option.value }}">{{ option.label }} <span class="filters-count">({{ option.count }})</span></label>
            </div>
            {% endfor %}
          </fieldset>
        </details>

        {% if filterPanel.categoryOptions.length %}
        <details class="filters-group">
          <summary class="filters-group-toggle">
            <span class="filters-group-title">{{ t('filters.category') }}</span>
            <span class="filters-group-value">{{ filterPanel.categorySummary }}</span>
          </summary>
          <fieldset class="filters-group-body filters-scroll">
            <legend class="filters-visually-hidden">{{ t('filters.category') }}</legend>
            {% for option in filterPanel.categoryOptions %}
            <div class="filters-choice">
              <input id="filters-category-{{ loop.index }}" type="checkbox" name="category" value="{{ option.value }}"{% if option.isChecked %} checked{% endif %} />
              <label for="filters-category-{{ loop.index }}">{{ option.label }} <span class="filters-count">({{ option.count }})</span></label>
            </div>
            {% endfor %}
          </fieldset>
        </details>
        {% endif %}

        <details class="filters-group">
          <summary class="filters-group-toggle">
            <span class="filters-group-title">{{ t('filters.price') }}</span>
            <span class="filters-group-value">{{ filterPanel.priceSummary }}</span>
          </summary>
          <fieldset class="filters-group-body">
            <legend class="filters-visually-hidden">{{ t('filters.price') }}</legend>
            <div class="filters-choice">
              <input id="filters-price-any" type="radio" name="price" value=""{% if filterPanel.isAnyPriceChecked %} checked{% endif %} />
              <label for="filters-price-any">{{ t('filters.anyPrice') }}</label>
            </div>
            {% for band in filterPanel.priceBands %}
            <div class="filters-choice">
              <input id="filters-price-{{ band.value }}" type="radio" name="price" value="{{ band.value }}"{% if band.isChecked %} checked{% endif %} />
              <label for="filters-price-{{ band.value }}">{{ band.label }}</label>
            </div>
            {% endfor %}
            <p class="filters-hint" id="filters-price-hint">{{ t('filters.ownRange') }}</p>
            <div class="filters-range">
              <div>
                <label for="filters-min-price">{{ t('filters.min', { symbol: filterPanel.currencySymbol }) }}</label>
                <input class="filters-input" id="filters-min-price" type="number" name="minPrice" min="0" step="0.01" inputmode="decimal" value="{{ filterPanel.minPrice }}" placeholder="0" aria-describedby="filters-price-hint" />
              </div>
              <div>
                <label for="filters-max-price">{{ t('filters.max', { symbol: filterPanel.currencySymbol }) }}</label>
                <input class="filters-input" id="filters-max-price" type="number" name="maxPrice" min="0" step="0.01" inputmode="decimal" value="{{ filterPanel.maxPrice }}" placeholder="{{ t('filters.any') }}" aria-describedby="filters-price-hint" />
              </div>
            </div>
          </fieldset>
        </details>
      </div>

      <div class="filters-actions">
        <button class="filters-apply" type="submit">{{ t('filters.apply') }}</button>
        <a class="filters-clear" href="{{ filterPanel.clearUrl }}">{{ t('filters.clearAll') }}</a>
      </div>
    </form>
  </details>

  {% if filterPanel.chips.length %}
  <ul class="filters-chips" aria-label="{{ t('filters.activeList') }}">
    {% for chip in filterPanel.chips %}
    <li>
      <a class="filters-chip" href="{{ chip.removeUrl }}">{{ chip.label }} <span aria-hidden="true">×</span><span class="filters-visually-hidden">{{ t('filters.remove') }}</span></a>
    </li>
    {% endfor %}
    <li><a class="filters-clear" href="{{ filterPanel.clearUrl }}">{{ t('filters.clear') }}</a></li>
  </ul>
  {% endif %}
</div>
