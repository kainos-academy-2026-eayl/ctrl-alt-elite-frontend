{% extends "layout.njk" %}

{% block title %}{{ t('login.title') }}{% endblock %}
{% block description %}{{ t('login.description') }}{% endblock %}
{% block bodyClass %}login-page{% endblock %}

{% block styles %}
  <link rel="stylesheet" href="/assets/login.css" />
{% endblock %}

{% block content %}
    <section class="login-container" aria-labelledby="login-heading">
      <p class="eyebrow">{{ t('login.eyebrow') }}</p>
      <h1 id="login-heading">{{ t('login.heading') }}</h1>
      <h2>{{ t('login.subheading') }}</h2>
      <form class="login-form" action="/login" method="post">
        {% if returnTo %}
        <input type="hidden" name="returnTo" value="{{ returnTo }}" />
        {% endif %}
        {% if errorMessage %}
        <p id="loginMessage" class="login-message" role="alert">{{ errorMessage }}</p>
        {% endif %}
        <div class="login-form-group">
          <label for="email">{{ t('login.email') }}</label>
          <input
            id="email"
            name="email"
            type="email"
            autocomplete="email"
            value="{{ email }}"
            maxlength="254"
            required
          />
        </div>
        <div class="login-form-group">
          <label for="password">{{ t('login.password') }}</label>
          <div class="password-field">
            <input
              id="password"
              name="password"
              type="password"
              autocomplete="current-password"
              maxlength="128"
              required
            />
            <button
              class="password-toggle"
              type="button"
              aria-controls="password"
              aria-label="{{ t('js.password.show') }}"
              title="{{ t('js.password.show') }}"
              data-password-toggle
              hidden
            >
              <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
                <path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7-10-7-10-7Z" />
                <circle cx="12" cy="12" r="3" />
                <path class="password-eye-slash" d="M3 3l18 18" />
              </svg>
            </button>
          </div>
        </div>
        <button class="login-btn" type="submit">{{ t('login.submit') }}</button>
      </form>
    </section>
{% endblock %}

{% block scripts %}
  <script src="/client/login.js" defer></script>
{% endblock %}
