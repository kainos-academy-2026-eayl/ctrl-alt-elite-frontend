{% extends "layout.njk" %}

{% block title %}Log in | Ctrl-Alt-Elite{% endblock %}
{% block description %}Log in to your Ctrl-Alt-Elite account.{% endblock %}
{% block bodyClass %}login-page{% endblock %}

{% block styles %}
  <link rel="stylesheet" href="/assets/login.css" />
{% endblock %}

{% block content %}
    <section class="login-container" aria-labelledby="login-heading">
      <p class="eyebrow">Welcome back</p>
      <h1 id="login-heading">Log in</h1>
      <h2>Please enter your details</h2>
      <form class="login-form" action="/login" method="post">
        {% if errorMessage %}
        <p id="loginMessage" class="login-message" role="alert">{{ errorMessage }}</p>
        {% endif %}
        <div class="login-form-group">
          <label for="email">Email address</label>
          <input
            id="email"
            name="email"
            type="email"
            autocomplete="email"
            value="{{ email }}"
            maxlength="254"
            required
          />
        </div>
        <div class="login-form-group">
          <label for="password">Password</label>
          <input
            id="password"
            name="password"
            type="password"
            autocomplete="current-password"
            maxlength="128"
            required
          />
        </div>
        <button class="login-btn" type="submit">Log in</button>
      </form>
    </section>
{% endblock %}
