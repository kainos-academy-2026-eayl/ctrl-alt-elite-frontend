{% extends "layout.njk" %}

{% block title %}{{ t('catalogue.title') }}{% endblock %}
{% block description %}{{ t('catalogue.description') }}{% endblock %}

{% block styles %}
<link rel="stylesheet" href="/product-catalog/product_catalog.css" />
<link rel="stylesheet" href="/assets/filters.css" />
{% endblock %}

{% block content %}
<div class="catalog-main">
    <section class="catalog-toolbar" aria-labelledby="catalogTitle">
        <p class="eyebrow">{{ t('catalogue.eyebrow') }}</p>
        <h1 id="catalogTitle">{{ pageHeading or t('catalogue.heading') }}</h1>
        {% if not productError %}
        <p class="catalog-summary" id="resultsCount" role="status">{{ resultsSummary or t('catalogue.intro') }}</p>
        {% endif %}
    </section>

    {% if filterPanel %}
    {% include "_filterPanel.njk" %}
    {% endif %}

    <section class="product-grid" id="productGrid" aria-label="{{ t('catalogue.products') }}">
        {% if productError %}
        <p class="empty-state" role="alert">{{ productError }}</p>
        {% else %}
        {% for product in products %}
        <article class="product-tile" data-product-card data-category="{{ product.category }}">
            <div class="product-image-wrap">
                <img class="product-image" src="{{ product.image }}" alt="{{ product.name }}" loading="lazy">
                <span class="product-category">{{ tCategory(product.category) }}</span>
            </div>
            <div class="product-content">
                <h2>{{ product.name }}</h2>
                <p class="product-price">{{ product.priceLabel }}</p>
                <p class="product-stock">{{ product.stockLabel }}</p>
                <div class="product-actions">
                    <a class="button button-secondary" href="/products/{{ product.id | urlencode }}" aria-label="{{ t('product.viewDetailsOf', { name: product.name }) }}">{{ t('product.viewDetails') }}</a>
                    <form action="/basket/items" method="post">
                        <input type="hidden" name="productId" value="{{ product.id }}" />
                        <button class="button button-primary" type="submit" {% if not product.available %}
                            disabled{% endif %}>{{ t('product.addToBasket') }}</button>
                    </form>
                </div>
            </div>
        </article>
        {% else %}
        <p class="empty-state">{{ t('catalogue.empty') }}</p>
        {% endfor %}
        {% endif %}
    </section>
    <a class="cta-button" href="/">{{ t('catalogue.goHome') }}</a>
</div>
{% endblock %}
