{% extends "layout.njk" %}

{% block title %}{{ t('profile.title') }}{% endblock %}
{% block description %}{{ t('profile.description') }}{% endblock %}

{% block styles %}
<link rel="stylesheet" href="/assets/profile.css" />
{% endblock %}

{% block content %}
<section class="page-width profile-page" aria-labelledby="profile-heading">
    <header class="profile-header">
        <p class="eyebrow">{{ t('profile.eyebrow') }}</p>
        <h1 id="profile-heading">{{ t('profile.heading') }}</h1>
        <p class="profile-copy">{{ t('profile.intro') }}</p>
    </header>

    {% if profileLoadMessage %}
    <p class="profile-notice" role="alert">{{ profileLoadMessage }} <a href="/login">{{ t('profile.login') }}</a></p>
    {% endif %}
    {% if message %}
    <p class="profile-notice" role="status">{{ message }}</p>
    {% endif %}
    {% if error %}
    <p class="profile-notice profile-error" role="alert">{{ error }}</p>
    {% endif %}

    <div class="profile-layout">
        <aside class="profile-card profile-summary" aria-label="{{ t('profile.current') }}">
            <div data-profile-photo>
            <img class="profile-preview-avatar" data-profile-image width="112" height="112" alt="{{ t('profile.pictureAlt') }}"{% if profile.hasPhoto %} src="/api/profile/photo"{% else %} hidden{% endif %} />
            <svg class="profile-preview-avatar" data-profile-fallback viewBox="0 0 64 64" width="112" height="112" aria-hidden="true" focusable="false"{% if profile.hasPhoto %} hidden{% endif %}>
                <circle cx="32" cy="32" r="32" fill="#dcfce7" />
                <circle cx="32" cy="24" r="11" fill="#14532d" />
                <path d="M12 57a20 20 0 0 1 40 0" fill="#14532d" />
            </svg>
            </div>
            <h2>{{ account.name }}</h2>
            <p class="profile-copy">{{ t('profile.personalSpace') }}</p>
            <section class="profile-credit" aria-labelledby="profile-credit-heading">
                <h3 class="profile-credit-label" id="profile-credit-heading">{{ t('profile.credit') }}</h3>
                {% if creditBalance %}
                <p class="profile-credit-amount">{{ creditBalance }}</p>
                {% else %}
                <p class="profile-credit-copy">{{ t('profile.creditUnavailable') }}</p>
                {% endif %}
            </section>
        </aside>

        <section class="profile-card profile-editor" aria-labelledby="profile-details-heading">
            <h2 id="profile-details-heading">{{ t('profile.details') }}</h2>
            <p class="profile-copy">{{ t('profile.detailsIntro') }}</p>

            <div class="profile-picture-field" data-profile-photo-editor data-has-photo="{{ profile.hasPhoto }}">
                <label for="profile-picture">{{ t('profile.picture') }}</label>
                <p class="profile-hint" id="profile-picture-hint">{{ t('profile.pictureHint') }}</p>
                <input type="file" id="profile-picture" name="profilePicture" accept="image/jpeg,image/png,image/webp" aria-describedby="profile-picture-hint"{% if not profile %} disabled{% endif %} />
                {% if profile %}
                <div class="profile-photo-actions">
                    <button class="profile-save-button" type="button" data-profile-photo-upload disabled>{{ t('profile.upload') }}</button>
                    <button class="profile-save-button profile-secondary-button" type="button" data-profile-photo-remove{% if not profile.hasPhoto %} hidden{% endif %}>{{ t('profile.removePicture') }}</button>
                </div>
                <p class="profile-hint" data-profile-photo-status role="status" aria-live="polite"></p>
                <p class="profile-error" data-profile-photo-error role="alert" hidden></p>
                <noscript><p class="profile-hint">{{ t('profile.noScript') }}</p></noscript>
                {% endif %}
            </div>

            <form action="/profile" method="post">
            <fieldset class="profile-details-fields"{% if not profile %} disabled{% endif %}>
            <legend class="profile-visually-hidden">{{ t('profile.fieldsLegend') }}</legend>
            <div class="profile-fields">
                <div class="profile-field profile-field-wide">
                    <label for="profile-username">{{ t('profile.username') }}</label>
                    <input type="text" id="profile-username" name="username" value="{{ form.username or '' }}" autocomplete="nickname" maxlength="30" placeholder="{{ t('profile.usernamePlaceholder') }}" aria-describedby="profile-username-hint" />
                    <p class="profile-hint" id="profile-username-hint">{{ t('profile.usernameHint') }}</p>
                </div>

                <div class="profile-field">
                    <label for="profile-first-name">{{ t('profile.firstName') }}</label>
                    <input type="text" id="profile-first-name" name="firstName" value="{{ form.firstName }}" autocomplete="given-name" maxlength="100" placeholder="{{ t('profile.firstNamePlaceholder') }}" required />
                </div>

                <div class="profile-field">
                    <label for="profile-second-name">{{ t('profile.lastName') }}</label>
                    <input type="text" id="profile-second-name" name="lastName" value="{{ form.lastName }}" autocomplete="family-name" maxlength="100" placeholder="{{ t('profile.lastNamePlaceholder') }}" required />
                </div>

                <div class="profile-field">
                    <label for="profile-email">{{ t('profile.email') }}</label>
                    <input type="email" id="profile-email" value="{{ profile.email }}" autocomplete="email" maxlength="254" readonly aria-describedby="profile-email-hint" />
                    <p class="profile-hint" id="profile-email-hint">{{ t('profile.emailHint') }}</p>
                </div>

                <div class="profile-field">
                    <label for="profile-phone">{{ t('profile.phone') }}</label>
                    <input type="tel" id="profile-phone" name="phoneNumber" value="{{ form.phoneNumber or '' }}" autocomplete="tel" maxlength="30" placeholder="{{ t('profile.phonePlaceholder') }}" />
                </div>

                <div class="profile-field profile-field-wide">
                    <label for="profile-address-line-1">{{ t('profile.addressLine1') }}</label>
                    <input type="text" id="profile-address-line-1" name="addressLine1" value="{{ form.addressLine1 or '' }}" autocomplete="address-line1" maxlength="200" placeholder="{{ t('profile.addressLine1') }}" />
                </div>

                <div class="profile-field profile-field-wide">
                    <label for="profile-address-line-2">{{ t('profile.addressLine2') }}</label>
                    <input type="text" id="profile-address-line-2" name="addressLine2" value="{{ form.addressLine2 or '' }}" autocomplete="address-line2" maxlength="200" placeholder="{{ t('profile.addressLine2') }}" />
                </div>

                <div class="profile-field">
                    <label for="profile-town">{{ t('profile.town') }}</label>
                    <input type="text" id="profile-town" name="town" value="{{ form.town or '' }}" autocomplete="address-level2" maxlength="60"{% if not profileTownSupported %} disabled aria-describedby="profile-town-hint"{% endif %} />
                    {% if profile and not profileTownSupported %}
                    <p class="profile-hint" id="profile-town-hint">{{ t('profile.townPending') }}</p>
                    {% endif %}
                </div>

                <div class="profile-field">
                    <label for="profile-postcode">{{ t('profile.postcode') }}</label>
                    <input type="text" id="profile-postcode" name="postcode" value="{{ form.postcode or '' }}" autocomplete="postal-code" maxlength="20" placeholder="{{ t('profile.postcodePlaceholder') }}" />
                </div>
            </div>

            <div class="profile-actions">
                <p class="profile-hint" id="profile-save-hint">{{ t('profile.saveHint') }}</p>
                <button class="profile-save-button" type="submit" aria-describedby="profile-save-hint"{% if not profile %} disabled{% endif %}>{{ t('profile.save') }}</button>
            </div>
            </fieldset>
            </form>
        </section>
    </div>
</section>
{% endblock %}