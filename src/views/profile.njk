{% extends "layout.njk" %}

{% block title %}My Profile | Ctrl-Alt-Elite{% endblock %}
{% block description %}Personalise your Ctrl-Alt-Elite profile.{% endblock %}

{% block styles %}
<link rel="stylesheet" href="/assets/profile.css" />
{% endblock %}

{% block navigation %}
<nav class="primary-nav" aria-label="Main navigation">
    <a class="nav-link" href="/">Back to home</a>
</nav>
{% endblock %}

{% block content %}
<section class="page-width profile-page" aria-labelledby="profile-heading">
    <header class="profile-header">
        <p class="eyebrow">Your account</p>
        <h1 id="profile-heading">My Profile</h1>
        <p class="profile-copy">A little about you. Make your profile feel like your own.</p>
    </header>

    {% if profileLoadMessage %}
    <p class="profile-notice" role="alert">{{ profileLoadMessage }} <a href="/login">Log in</a></p>
    {% endif %}
    {% if message %}
    <p class="profile-notice" role="status">{{ message }}</p>
    {% endif %}
    {% if error %}
    <p class="profile-notice profile-error" role="alert">{{ error }}</p>
    {% endif %}

    <div class="profile-layout">
        <aside class="profile-card profile-summary" aria-label="Current profile">
            <div data-profile-photo>
            <img class="profile-preview-avatar" data-profile-image width="112" height="112" alt="Your profile picture"{% if profile.hasPhoto %} src="/api/profile/photo"{% else %} hidden{% endif %} />
            <svg class="profile-preview-avatar" data-profile-fallback viewBox="0 0 64 64" width="112" height="112" aria-hidden="true" focusable="false"{% if profile.hasPhoto %} hidden{% endif %}>
                <circle cx="32" cy="32" r="32" fill="#dcfce7" />
                <circle cx="32" cy="24" r="11" fill="#14532d" />
                <path d="M12 57a20 20 0 0 1 40 0" fill="#14532d" />
            </svg>
            </div>
            <h2>{{ account.name }}</h2>
            <p class="profile-copy">Your personal space on Ctrl-Alt-Elite.</p>
        </aside>

        <section class="profile-card profile-editor" aria-labelledby="profile-details-heading">
            <h2 id="profile-details-heading">Profile details</h2>
            <p class="profile-copy">The details that make you, you.</p>

            <div class="profile-picture-field" data-profile-photo-editor data-has-photo="{{ profile.hasPhoto }}">
                <label for="profile-picture">Profile picture</label>
                <p class="profile-hint" id="profile-picture-hint">Choose a JPG, PNG or WebP image, up to 20 MiB and 16 megapixels. Your picture is saved separately from your details.</p>
                <input type="file" id="profile-picture" name="profilePicture" accept="image/jpeg,image/png,image/webp" aria-describedby="profile-picture-hint"{% if not profile %} disabled{% endif %} />
                {% if profile %}
                <div class="profile-photo-actions">
                    <button class="profile-save-button" type="button" data-profile-photo-upload disabled>Upload picture</button>
                    <button class="profile-save-button profile-secondary-button" type="button" data-profile-photo-remove{% if not profile.hasPhoto %} hidden{% endif %}>Remove picture</button>
                </div>
                <p class="profile-hint" data-profile-photo-status role="status" aria-live="polite"></p>
                <p class="profile-error" data-profile-photo-error role="alert" hidden></p>
                <noscript><p class="profile-hint">Enable JavaScript to upload or remove your picture. Your details can still be saved below.</p></noscript>
                {% endif %}
            </div>

            <form action="/profile" method="post">
            <fieldset class="profile-details-fields"{% if not profile %} disabled{% endif %}>
            <legend class="profile-visually-hidden">Your profile details</legend>
            <div class="profile-fields">
                <div class="profile-field profile-field-wide">
                    <label for="profile-username">Username</label>
                    <input type="text" id="profile-username" name="username" value="{{ form.username or '' }}" autocomplete="nickname" maxlength="30" placeholder="Your username" aria-describedby="profile-username-hint" />
                    <p class="profile-hint" id="profile-username-hint">Display name only, not a login. Leave blank to use your first and last name.</p>
                </div>

                <div class="profile-field">
                    <label for="profile-first-name">First name</label>
                    <input type="text" id="profile-first-name" name="firstName" value="{{ form.firstName }}" autocomplete="given-name" maxlength="100" placeholder="Your first name" required />
                </div>

                <div class="profile-field">
                    <label for="profile-second-name">Second name</label>
                    <input type="text" id="profile-second-name" name="lastName" value="{{ form.lastName }}" autocomplete="family-name" maxlength="100" placeholder="Your second name" required />
                </div>

                <div class="profile-field">
                    <label for="profile-email">Email address</label>
                    <input type="email" id="profile-email" value="{{ profile.email }}" autocomplete="email" maxlength="254" readonly aria-describedby="profile-email-hint" />
                    <p class="profile-hint" id="profile-email-hint">Your login email cannot be changed here.</p>
                </div>

                <div class="profile-field">
                    <label for="profile-phone">Phone number</label>
                    <input type="tel" id="profile-phone" name="phoneNumber" value="{{ form.phoneNumber or '' }}" autocomplete="tel" maxlength="30" placeholder="Your phone number" />
                </div>

                <div class="profile-field profile-field-wide">
                    <label for="profile-address-line-1">Address line 1</label>
                    <input type="text" id="profile-address-line-1" name="addressLine1" value="{{ form.addressLine1 or '' }}" autocomplete="address-line1" maxlength="200" placeholder="Address line 1" />
                </div>

                <div class="profile-field profile-field-wide">
                    <label for="profile-address-line-2">Address line 2</label>
                    <input type="text" id="profile-address-line-2" name="addressLine2" value="{{ form.addressLine2 or '' }}" autocomplete="address-line2" maxlength="200" placeholder="Address line 2" />
                </div>

                <div class="profile-field">
                    <label for="profile-postcode">Postcode</label>
                    <input type="text" id="profile-postcode" name="postcode" value="{{ form.postcode or '' }}" autocomplete="postal-code" maxlength="20" placeholder="Your postcode" />
                </div>
            </div>

            <div class="profile-actions">
                <p class="profile-hint" id="profile-save-hint">First and last names are required. Address, phone and display name are optional.</p>
                <button class="profile-save-button" type="submit" aria-describedby="profile-save-hint"{% if not profile %} disabled{% endif %}>Save changes</button>
            </div>
            </fieldset>
            </form>
        </section>
    </div>
</section>
{% endblock %}

{% block scripts %}
<script src="/controllers/script.js" defer></script>
{% endblock %}