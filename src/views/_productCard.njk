<li class="product-card">
  <img class="product-image" src="{{ product.imageUrl }}" alt="{{ product.name }}" width="160" height="120" />
  <h3>{{ product.name }}</h3>
  <p class="product-description">{{ product.description }}</p>
  <p class="product-price">£{{ product.price }}</p>
  {% if product.isInStock %}
  <p class="product-availability product-availability-in-stock">In Stock</p>
  <button type="button" class="basket-button" data-add-to-basket data-product-id="{{ product.id }}"
    data-product-name="{{ product.name }}" data-product-price="{{ product.price }}">Add to Basket</button>
  {% else %}
  <p class="product-availability product-availability-out-of-stock">Out of Stock</p>
  {% endif %}
</li>
