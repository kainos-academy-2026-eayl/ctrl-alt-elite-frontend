{% extends "layout.njk" %}

{% block title %}{{ t('support.title', { title: title }) }}{% endblock %}
{% block description %}{{ t('support.description') }}{% endblock %}
{% block bodyClass %}support-page{% endblock %}

{% block styles %}
  <link rel="stylesheet" href="/assets/support.css" />
{% endblock %}

{% block content %}
    <div class="support-container" data-support-page="{{ page }}">
      <header class="support-header">
        <div>
          <p class="eyebrow">{{ t('support.eyebrow') }}</p>
          <h1>{{ title }}</h1>
        </div>
        {% if page == "list" %}
        <a class="support-button" href="/account/support/new">{{ t('support.create') }}</a>
        {% else %}
        <a class="support-link" href="/account/support">{{ t('support.back') }}</a>
        {% endif %}
      </header>

      {% if page == "list" %}
      <div data-support-list aria-live="polite">
        <p class="support-muted">{{ t('js.support.loadingTickets') }}</p>
      </div>
      {% elif page == "detail" %}
      <div data-support-detail aria-live="polite">
        <p class="support-muted">{{ t('js.support.loadingTicket') }}</p>
      </div>
      {% else %}
      <section class="support-card" aria-labelledby="new-ticket-heading">
        <h2 id="new-ticket-heading">{{ t('support.newHeading') }}</h2>
        <form class="support-form" novalidate data-ticket-form>
          <div class="support-field">
            <label for="ticket-subject">{{ t('support.subject') }}</label>
            <input id="ticket-subject" name="subject" type="text" maxlength="{{ maxSubjectLength }}" required />
          </div>
          <div class="support-field">
            <label for="ticket-category">{{ t('support.category') }}</label>
            <select id="ticket-category" name="category" required>
              <option value="" selected disabled>{{ t('support.chooseCategory') }}</option>
              {% for category in categories %}
              <option value="{{ category.value }}">{{ t('js.ticketCategory.' + category.value) }}</option>
              {% endfor %}
            </select>
          </div>
          <div class="support-field">
            <label for="ticket-description">{{ t('support.ticketDescription') }}</label>
            <textarea id="ticket-description" name="description" rows="7" maxlength="{{ maxDescriptionLength }}" required></textarea>
          </div>
          <p class="support-error" role="alert" hidden data-ticket-error></p>
          <button class="support-button" type="submit" data-ticket-submit>{{ t('support.submit') }}</button>
        </form>
      </section>
      {% endif %}
    </div>
{% endblock %}

{% block scripts %}
  <script src="/controllers/support.js" defer></script>
{% endblock %}
