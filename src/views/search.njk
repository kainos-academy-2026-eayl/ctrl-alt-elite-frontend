{#
  KAN-23 Product search results. Rendered on the server: SearchController
  calls the backend search and search.page.ts builds the data shown here.
#}
{% extends "layout.njk" %}

{% block title %}{{ t('search.title') }}{% endblock %}
{% block description %}{{ t('search.description') }}{% endblock %}

{% block styles %}
<link rel="stylesheet" href="/product-catalog/product_catalog.css" />
<link rel="stylesheet" href="/assets/filters.css" />
{% endblock %}

{% block content %}
<div class="catalog-main search-results">
  <section class="catalog-toolbar" aria-labelledby="search-heading">
    <p class="eyebrow">{{ t('search.button') }}</p>
    <h1 id="search-heading" class="search-heading">{{ t('search.heading') }}</h1>
    {% if errorMessage %}
    <p class="basket-alert" role="alert">{{ errorMessage }}</p>
    {% else %}
    <p class="catalog-summary search-message" role="status">{{ statusMessage }}</p>
    {% endif %}
  </section>
  {% if filterPanel %}
  {% include "_filterPanel.njk" %}
  {% endif %}
  {% if products.length %}
  <section class="product-grid" aria-label="{{ t('catalogue.products') }}">
    {% for product in products %}
    {% set tile = { id: product.id, name: product.name, image: product.imageUrl, price: product.price, stock: t('product.inStock') if product.isInStock else t('product.outOfStock'), available: product.isInStock, category: '' } %}
    {% include "_productTile.njk" %}
    {% endfor %}
  </section>
  {% endif %}
</div>
{% endblock %}
