{#
  KAN-23 Product search results. Rendered on the server: SearchController
  calls the backend search and search.page.ts builds the data shown here.
#}
{% extends "layout.njk" %}

{% block title %}{{ t('search.title') }}{% endblock %}
{% block description %}{{ t('search.description') }}{% endblock %}

{% block styles %}
<link rel="stylesheet" href="/assets/basket.css" />
<link rel="stylesheet" href="/assets/search.css" />
<link rel="stylesheet" href="/assets/filters.css" />
{% endblock %}

{% block navigation %}
<nav class="primary-nav" aria-label="{{ t('site.mainNavigation') }}">
  {% include "_searchForm.njk" %}
  {% include "_basketLink.njk" %}
</nav>
{% endblock %}

{% block content %}
<section class="page-width products search-results" aria-labelledby="search-heading">
  <h1 id="search-heading" class="search-heading">{{ t('search.heading') }}</h1>
  {% if filterPanel %}
  {% include "_filterPanel.njk" %}
  {% endif %}
  {% if errorMessage %}
  <p class="basket-alert" role="alert">{{ errorMessage }}</p>
  {% else %}
  <p class="search-message" role="status">{{ statusMessage }}</p>
  {% endif %}
  {% if products.length %}
  <ul class="product-grid">
    {% for product in products %}
    {% include "_productCard.njk" %}
    {% endfor %}
  </ul>
  {% endif %}
</section>
{% endblock %}
