{% extends "admin/layout.njk" %}

{% block content %}
<p><a href="{{ backUrl }}">&larr; Back to customers</a></p>

{% if error %}
<header class="admin-page-header">
  <h1>Customer details</h1>
</header>
<section class="admin-card customer-state" role="alert" aria-labelledby="customer-error-heading">
  <h2 id="customer-error-heading">{{ errorTitle }}</h2>
  <p class="admin-empty">{{ errorMessage }}</p>
</section>
{% else %}
<header class="admin-page-header">
  <h1>{{ customer.name }}</h1>
</header>
<section class="admin-card" aria-labelledby="customer-details-heading">
  <h2 id="customer-details-heading">Customer details</h2>
  <dl class="customer-details">
    <div>
      <dt>Customer Name</dt>
      <dd>{{ customer.name }}</dd>
    </div>
    <div>
      <dt>Email Address</dt>
      <dd>{{ customer.email }}</dd>
    </div>
    <div>
      <dt>Registration Date</dt>
      <dd><time datetime="{{ customer.registrationDate }}">{{ customer.registeredDisplay }}</time></dd>
    </div>
  </dl>
</section>
{% endif %}
{% endblock %}
