{% extends "admin/layout.njk" %}

{% block content %}
<header class="admin-page-header">
  <h1>Dashboard</h1>
  <p class="admin-subtitle">Overview of your store. Customer figures are live; other figures are placeholders until they are connected.</p>
</header>

<section aria-labelledby="summary-heading">
  <h2 id="summary-heading" class="visually-hidden">Summary</h2>
  <ul class="admin-summary-grid">
    {% for card in summaryCards %}
    <li class="admin-card admin-summary-card">
      <span class="admin-summary-label">{{ card.label }}</span>
      <span class="admin-summary-value">{{ card.value }}</span>
    </li>
    {% endfor %}
  </ul>
</section>

<div class="admin-grid">
  <section class="admin-card" aria-labelledby="quick-actions-heading">
    <h2 id="quick-actions-heading">Quick Actions</h2>
    <ul class="admin-action-list">
      {% for action in quickActions %}
      <li><a class="admin-action" href="{{ action.href }}">{{ action.label }}</a></li>
      {% endfor %}
    </ul>
  </section>

  <section class="admin-card" aria-labelledby="notifications-heading">
    <h2 id="notifications-heading">Notifications</h2>
    {% if notifications.length %}
    <ul class="admin-feed">
      {% for message in notifications %}
      <li><a href="/admin/customers?sort=newest">{{ message }}</a></li>
      {% endfor %}
    </ul>
    {% else %}
    <p class="admin-empty">No active notifications</p>
    {% endif %}
  </section>

  <section class="admin-card" aria-labelledby="activity-heading">
    <h2 id="activity-heading">Recent Activity</h2>
    {% if activity.length %}
    <ul class="admin-feed">
      {% for item in activity %}
      <li>
        <a href="/admin/customers/{{ item.id }}">{{ item.name }}</a> registered
        <time datetime="{{ item.registrationDate }}">{{ item.registeredDisplay }}</time>
      </li>
      {% endfor %}
    </ul>
    {% else %}
    <p class="admin-empty">No recent activity available</p>
    {% endif %}
  </section>

  <section class="admin-card" aria-labelledby="status-heading">
    <h2 id="status-heading">System Status</h2>
    <ul class="admin-status-list">
      {% for service in systemStatus %}
      <li>
        <span>{{ service.label }}</span>
        <span class="admin-status-badge{% if service.ok %} is-ok{% endif %}">{{ service.text }}</span>
      </li>
      {% endfor %}
    </ul>
  </section>
</div>
{% endblock %}
