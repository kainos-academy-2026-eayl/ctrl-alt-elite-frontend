{#
  KAN-28 Basket page. Rendered on the server: BasketController loads the
  basket and basket.page.ts builds the data shown here. The +, − and Remove
  buttons are forms that post back to /basket, so no JavaScript is needed.
#}
{% extends "layout.njk" %}

{% block title %}{{ t('basket.title') }}{% endblock %}
{% block description %}{{ t('basket.description') }}{% endblock %}

{% block styles %}
<link rel="stylesheet" href="/assets/basket.css" />
{% endblock %}

{% block navigation %}
<nav class="primary-nav" aria-label="{{ t('site.mainNavigation') }}">
  {% include "_basketLink.njk" %}
</nav>
{% endblock %}

{% block content %}
<section class="page-width basket" aria-labelledby="basket-heading">
  <h1 id="basket-heading" tabindex="-1"{% if focusTarget == "heading" %} autofocus{% endif %}>{{ t('basket.heading') }}</h1>

  {% if notice %}
  <p class="basket-notice{% if notice.isError %} basket-notice--error{% endif %}" role="{% if notice.isError %}alert{% else %}status{% endif %}">{{ notice.message }}</p>
  {% endif %}

  {% if loadErrorMessage %}
  <p class="basket-alert" role="alert">{{ loadErrorMessage }}</p>
  {% elif isEmpty %}
  <div class="basket-empty">
    <p>{{ t('basket.empty') }}</p>
    <a class="basket-button" href="/">{{ t('basket.browse') }}</a>
  </div>
  {% else %}
  <table class="basket-table">
    <caption class="basket-visually-hidden">{{ t('basket.caption') }}</caption>
    <thead>
      <tr>
        <th scope="col">{{ t('basket.product') }}</th>
        <th scope="col">{{ t('basket.unitPrice') }}</th>
        <th scope="col">{{ t('basket.quantity') }}</th>
        <th scope="col">{{ t('basket.lineTotal') }}</th>
        <th scope="col"><span class="basket-visually-hidden">{{ t('basket.actions') }}</span></th>
      </tr>
    </thead>
    <tbody>
      {% for line in lines %}
      <tr>
        <th scope="row">{{ line.name }}</th>
        <td data-label="{{ t('basket.unitPrice') }}">{{ line.unitPrice }}</td>
        <td data-label="{{ t('basket.quantity') }}">
          <div class="basket-quantity">
            <form action="{{ line.updateUrl }}" method="post">
              <input type="hidden" name="change" value="-1" />
              <button type="submit" aria-label="{{ t('basket.decrease', { name: line.name }) }}"{% if not line.canDecrease %} disabled{% endif %}{% if line.focusDecrease %} autofocus{% endif %}>−</button>
            </form>
            <span class="basket-quantity__value">{{ line.quantity }}</span>
            <form action="{{ line.updateUrl }}" method="post">
              <input type="hidden" name="change" value="1" />
              <button type="submit" aria-label="{{ t('basket.increase', { name: line.name }) }}"{% if not line.canIncrease %} disabled{% endif %}{% if line.focusIncrease %} autofocus{% endif %}>+</button>
            </form>
          </div>
        </td>
        <td data-label="{{ t('basket.lineTotal') }}" class="basket-line-total">{{ line.lineTotal }}</td>
        <td data-label="">
          <form action="{{ line.removeUrl }}" method="post">
            <button type="submit" class="basket-remove" aria-label="{{ t('basket.removeName', { name: line.name }) }}">{{ t('basket.remove') }}</button>
          </form>
        </td>
      </tr>
      {% endfor %}
    </tbody>
  </table>

  <div class="basket-summary">
    <p class="basket-total">
      {{ t('basket.total', { items: basketSummary.itemCountText }) }}
      <strong>{{ total }}</strong>
    </p>
    {% if currencyNote %}
    <p class="basket-currency-note">{{ currencyNote }}</p>
    {% endif %}
    <form action="/basket/checkout" method="post">
      <button type="submit" class="basket-button">{{ t('basket.checkout') }}</button>
    </form>
  </div>
  {% endif %}
</section>
{% endblock %}
