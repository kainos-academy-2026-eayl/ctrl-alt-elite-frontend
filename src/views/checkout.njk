{% extends "layout.njk" %}

{% block title %}{% if errors.length %}Error: {% endif %}Checkout | Ctrl-Alt-Elite{% endblock %}
{% block description %}Enter your details, choose delivery and pay for your order.{% endblock %}

{% block styles %}
<link rel="stylesheet" href="/assets/basket.css" />
<link rel="stylesheet" href="/assets/checkout.css" />
{% endblock %}

{% block navigation %}
<nav class="primary-nav" aria-label="Main navigation">
  <a class="nav-link basket-icon-link" href="/basket">
    <svg class="basket-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
      <path d="M7 18a2 2 0 1 0 0 4 2 2 0 0 0 0-4Zm10 0a2 2 0 1 0 0 4 2 2 0 0 0 0-4ZM1 2h3.3l.9 2H22l-3.6 8.4a2 2 0 0 1-1.8 1.2H8.1l-1 1.8V16h12v2H5.3a1.3 1.3 0 0 1-1.1-2l1.4-2.6L2.7 4H1V2Z" />
    </svg>
    <span class="basket-visually-hidden">Basket, {{ basketSummary.itemCountText }}</span>
    <span class="basket-badge" aria-hidden="true">{{ basketSummary.itemCount }}</span>
  </a>
</nav>
{% endblock %}

{% macro textField(name, label, values, fieldErrors, type="text", autocomplete="", hint="", optional=false, width="", maxlength="", inputmode="") %}
<div class="checkout-field{% if fieldErrors[name] %} checkout-field-error{% endif %}">
  <label class="checkout-label" for="{{ name }}">{{ label }}{% if optional %} (optional){% endif %}</label>
  {% if hint %}<p class="checkout-hint" id="{{ name }}-hint">{{ hint }}</p>{% endif %}
  {% if fieldErrors[name] %}<p class="checkout-error-message" id="{{ name }}-error"><span class="basket-visually-hidden">Error:</span> {{ fieldErrors[name] }}</p>{% endif %}
  <input class="checkout-input{% if width %} checkout-input-{{ width }}{% endif %}" id="{{ name }}" name="{{ name }}" type="{{ type }}" value="{{ values[name] }}"{% if maxlength %} maxlength="{{ maxlength }}"{% endif %}{% if inputmode %} inputmode="{{ inputmode }}"{% endif %}{% if autocomplete %} autocomplete="{{ autocomplete }}"{% endif %}{% if not optional %} required{% endif %}{% if fieldErrors[name] %} aria-invalid="true"{% endif %}{% if hint or fieldErrors[name] %} aria-describedby="{% if hint %}{{ name }}-hint{% endif %}{% if hint and fieldErrors[name] %} {% endif %}{% if fieldErrors[name] %}{{ name }}-error{% endif %}"{% endif %} />
</div>
{% endmacro %}

{% macro hiddenFields(names, values) %}
{% for name in names %}<input type="hidden" name="{{ name }}" value="{{ values[name] }}" />
{% endfor %}
{% endmacro %}

{% set detailFields = ["firstName", "lastName", "email", "phone", "postcode", "addressLine1", "addressLine2", "town"] %}

{% block content %}
<section class="page-width checkout" aria-labelledby="checkout-heading">
  <h1 id="checkout-heading">Checkout</h1>

  {% if isGuest %}
  <div class="checkout-panel checkout-login">
    <h2>Log in to check out</h2>
    <p>Orders are paid from the credit balance on your account, so please log in or create an account first. Your basket will be kept.</p>
    <div class="checkout-actions">
      <a class="basket-button" href="{{ loginUrl }}">Log in</a>
      <a class="checkout-secondary-button" href="{{ registerUrl }}">Create an account</a>
    </div>
    <p class="checkout-login-basket">Your basket: {{ itemCountText }}, {{ itemsTotal }}</p>
  </div>
  {% else %}

  {% if errors.length %}
  <div class="checkout-error-summary" role="alert" aria-labelledby="error-summary-heading" tabindex="-1">
    <h2 id="error-summary-heading">There is a problem</h2>
    <ul>
      {% for error in errors %}
      <li><a href="{{ error.href }}">{{ error.message }}</a></li>
      {% endfor %}
    </ul>
  </div>
  {% endif %}
  {% if notice %}
  <p class="basket-alert checkout-notice" role="alert">{{ notice }}</p>
  {% endif %}

  <div class="checkout-layout">
    <form class="checkout-form" action="{{ checkoutUrl }}" method="post">

      {# Step 1: your details and address #}
      <section class="checkout-panel" aria-labelledby="details-heading">
        <h2 id="details-heading" class="checkout-step-heading"><span class="checkout-step-number" aria-hidden="true">1</span> Your details</h2>
        {% if step == "details" %}
        {{ textField("firstName", "First name", values, fieldErrors, autocomplete="given-name", maxlength=100) }}
        {{ textField("lastName", "Last name", values, fieldErrors, autocomplete="family-name", maxlength=100) }}
        {{ textField("email", "Email address", values, fieldErrors, type="email", autocomplete="email", maxlength=254, hint="For example, name@example.com") }}
        {{ textField("phone", "Phone number", values, fieldErrors, type="tel", autocomplete="tel", hint="A UK number, for example 07700 900123", width="medium", maxlength=20, inputmode="tel") }}

        <h3 class="checkout-subheading">Home address</h3>
        <p class="checkout-hint">Enter your address below. We will check that your postcode exists.</p>
        {{ textField("postcode", "Postcode", values, fieldErrors, autocomplete="postal-code", width="short", maxlength=8) }}
        {{ textField("addressLine1", "Address line 1", values, fieldErrors, autocomplete="address-line1", maxlength=100) }}
        {{ textField("addressLine2", "Address line 2", values, fieldErrors, autocomplete="address-line2", optional=true, maxlength=100) }}
        {{ textField("town", "Town or city", values, fieldErrors, autocomplete="address-level2", width="medium", maxlength=60) }}
        {{ hiddenFields(["deliveryOption"], values) }}
        <button class="basket-button" type="submit" name="action" value="continue-to-delivery">Continue to delivery</button>
        {% else %}
        {{ hiddenFields(detailFields, values) }}
        <dl class="checkout-summary-list">
          <div><dt>Name</dt><dd>{{ detailsSummary.name }}</dd></div>
          <div><dt>Email</dt><dd>{{ detailsSummary.email }}</dd></div>
          <div><dt>Phone</dt><dd>{{ detailsSummary.phone }}</dd></div>
          <div><dt>Address</dt><dd>{% for line in detailsSummary.addressLines %}{{ line }}{% if not loop.last %}<br />{% endif %}{% endfor %}</dd></div>
        </dl>
        <button class="checkout-change" type="submit" name="action" value="edit-details" formnovalidate>Change<span class="basket-visually-hidden"> your details</span></button>
        {% endif %}
      </section>

      {# Step 2: delivery #}
      <section class="checkout-panel{% if step == 'details' %} checkout-panel-upcoming{% endif %}" aria-labelledby="delivery-heading">
        <h2 id="delivery-heading" class="checkout-step-heading"><span class="checkout-step-number" aria-hidden="true">2</span> Delivery</h2>
        {% if step == "delivery" %}
        <div class="checkout-field{% if fieldErrors.deliveryOption %} checkout-field-error{% endif %}">
          <fieldset class="checkout-fieldset" id="deliveryOption"{% if fieldErrors.deliveryOption %} aria-describedby="deliveryOption-error"{% endif %}>
            <legend class="checkout-label">How would you like to get your order?</legend>
            {% if fieldErrors.deliveryOption %}<p class="checkout-error-message" id="deliveryOption-error"><span class="basket-visually-hidden">Error:</span> {{ fieldErrors.deliveryOption }}</p>{% endif %}
            <h3 class="checkout-subheading">Home delivery</h3>
            {% for option in homeDeliveryOptions %}
            <div class="checkout-radio">
              <input id="delivery-{{ option.id }}" type="radio" name="deliveryOption" value="{{ option.id }}"{% if option.isChecked %} checked{% endif %} />
              <label for="delivery-{{ option.id }}"><strong>{{ option.name }}</strong> ({{ option.description }}) <span class="checkout-option-price">{{ option.price }}</span></label>
            </div>
            {% endfor %}
            <h3 class="checkout-subheading">Collect from a drop-off point</h3>
            {% for option in collectionOptions %}
            <div class="checkout-radio">
              <input id="delivery-{{ option.id }}" type="radio" name="deliveryOption" value="{{ option.id }}"{% if option.isChecked %} checked{% endif %} />
              <label for="delivery-{{ option.id }}"><strong>{{ option.name }}</strong>, {{ option.description }} <span class="checkout-option-price">{{ option.price }}</span></label>
            </div>
            {% endfor %}
          </fieldset>
        </div>
        <button class="basket-button" type="submit" name="action" value="continue-to-payment">Continue to payment</button>
        {% elif step == "payment" %}
        {{ hiddenFields(["deliveryOption"], values) }}
        <dl class="checkout-summary-list">
          <div><dt>Delivery</dt><dd>{{ deliverySummary.name }}, {{ deliverySummary.description }} ({{ deliverySummary.price }})</dd></div>
        </dl>
        <button class="checkout-change" type="submit" name="action" value="edit-delivery" formnovalidate>Change<span class="basket-visually-hidden"> delivery</span></button>
        {% endif %}
      </section>

      {# Step 3: payment from the account's credit balance #}
      <section class="checkout-panel{% if step != 'payment' %} checkout-panel-upcoming{% endif %}" aria-labelledby="payment-heading">
        <h2 id="payment-heading" class="checkout-step-heading"><span class="checkout-step-number" aria-hidden="true">3</span> Payment</h2>
        {% if step == "payment" %}
        <p>Your order will be paid from the credit balance on your account.</p>
        <dl class="checkout-summary-list checkout-payment">
          <div><dt>Credit balance</dt><dd>{{ payment.creditBalance }}</dd></div>
          <div><dt>Items</dt><dd>{{ payment.itemsTotal }}</dd></div>
          <div><dt>Delivery</dt><dd>{{ payment.deliveryPrice }}</dd></div>
          <div class="checkout-payment-total"><dt>Order total</dt><dd>{{ payment.total }}</dd></div>
          <div><dt>Balance after this order</dt><dd>{{ payment.balanceAfter }}</dd></div>
        </dl>
        {% if not payment.canAfford %}
        <p class="basket-alert" role="alert">Your credit balance is not enough to pay for this order. Remove some items from your basket or choose a cheaper delivery option.</p>
        {% endif %}
        {% if not orderOutcomeUnknown %}
        <input type="hidden" name="confirmedTotalPence" value="{{ payment.totalPence }}" />
        <button class="basket-button checkout-submit" type="submit" name="action" value="place-order"{% if not payment.canAfford %} disabled{% endif %}>Checkout</button>
        {% endif %}
        {% endif %}
      </section>
    </form>

    <aside class="checkout-panel checkout-basket" aria-labelledby="basket-summary-heading">
      <h2 id="basket-summary-heading">Your basket</h2>
      <ul class="checkout-lines">
        {% for line in lines %}
        <li><span>{{ line.quantity }} × {{ line.name }}</span><span>{{ line.lineTotal }}</span></li>
        {% endfor %}
      </ul>
      <p class="checkout-basket-total"><span>Items ({{ itemCountText }})</span><strong>{{ itemsTotal }}</strong></p>
      <a href="/basket">Edit basket</a>
    </aside>
  </div>
  {% endif %}
</section>
{% endblock %}
