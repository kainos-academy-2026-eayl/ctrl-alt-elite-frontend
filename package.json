{
  "name": "technologist-academy-node-service-template",
  "version": "1.0.0",
  "description": "A template repository for node services developed in the Technologist Academy",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "npm run build:client && tsx watch src/index.ts",
    "dev:client": "npm run build:client -- --watch",
    "build": "npm run typecheck && npm run build:client && esbuild src/index.ts --bundle --platform=node --format=esm --target=node22 --packages=external --outfile=dist/index.js --sourcemap",
    "typecheck": "tsc && tsc -p tsconfig.client.json",
    "build:client": "esbuild src/controllers/*.ts --bundle --format=iife --target=es2022 --outdir=dist/public/controllers --sourcemap",
    "start": "node dist/index.js",
    "prepare": "husky",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "pretest": "npm run build:client",
    "test": "vitest run --passWithNoTests",
    "format": "biome format --write ."
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/express": "^5.0.6",
    "@types/node": "26.4.1",
    "@types/nunjucks": "^3.2.6",
    "esbuild": "0.28.2",
    "husky": "^9.1.7",
    "tsx": "4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "dotenv": "17.4.2",
    "express": "^5.2.1",
    "jose": "^6.1.0",
    "nunjucks": "^3.2.4"
  }
}
